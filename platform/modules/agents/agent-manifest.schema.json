{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneshowseo.com/schemas/agent-manifest-v1.json",
  "title": "OneShowSEO Agent Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "version", "metadata", "capabilities", "dependencies", "entitlements", "risks", "schedules", "compatibility"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["zh-CN", "en"], "properties": {"zh-CN": {"$ref": "#/$defs/metadata"}, "en": {"$ref": "#/$defs/metadata"}}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "dependencies": {"type": "object", "required": ["providers", "agents"], "properties": {"providers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "agents": {"type": "array", "items": {"type": "object", "required": ["key", "versionRange"]}}}},
    "entitlements": {"type": "array", "items": {"type": "object", "required": ["key", "minimumPlan", "quantity"]}},
    "risks": {"type": "array", "items": {"type": "object", "required": ["capability", "level", "approval"]}},
    "schedules": {"type": "array", "items": {"type": "object", "required": ["key", "cron", "minimumIntervalSeconds", "timezone"]}},
    "compatibility": {"type": "object", "required": ["platform", "manifestVersions"]}
  },
  "$defs": {
    "metadata": {"type": "object", "additionalProperties": false, "required": ["name", "description"], "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "capability": {"type": "object", "required": ["key", "input", "output", "events", "permissions"]}
  }
}
