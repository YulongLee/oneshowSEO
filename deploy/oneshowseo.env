NODE_ENV=production
NODE_NO_WARNINGS=1
HOST=127.0.0.1
PORT=8788
APP_URL=https://oneshowseo.com
BILLING_LIVE_ENABLED=false
WORKER_RUNTIME_ENABLED=true
WORKERS_REQUIRED=true
WORKER_CONCURRENCY=2
ADMIN_EMAIL=1797358496@qq.com
DATABASE_PATH=/var/www/oneshowseo/data/oneshowseo.sqlite
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_FROM=OneShowTools <noreply@mail.oneshowtools.com>
# EMAIL_SMTP_USER and EMAIL_SMTP_PASSWORD are injected only on the server.
# SMS authentication is fail-closed until all Aliyun values are injected on the server.
SMS_AUTH_ENABLED=false
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_REGION_ID=cn-qingdao
SMS_CODE_TTL_SECONDS=300
# ALIYUN_SMS_ACCESS_KEY_ID, ALIYUN_SMS_ACCESS_KEY_SECRET, ALIYUN_SMS_SIGN_NAME,
# ALIYUN_SMS_TEMPLATE_CODE and SMS_PHONE_HASH_KEY are injected only on the server.
